<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?android:attr/colorBackground" android:orientation="vertical">
  <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar_backup_recovery" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="?android:attr/colorBackground" android:theme="@style/DesktopToolbarTheme" android:elevation="0dp"/>
