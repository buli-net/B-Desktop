<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
  <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar_address_book" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="?android:attr/colorBackground" android:theme="@style/DesktopToolbarTheme" android:elevation="0dp"/>
  <include layout="@layout/desktop_navigation"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:padding="8dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:padding="8dp">
