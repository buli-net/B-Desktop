        <LinearLayout android:id="@+id/addressBookList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp"/>
      </ScrollView>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
